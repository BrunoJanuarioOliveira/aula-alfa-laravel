APP_NAME="Rede Patas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco padrão: SQLite (o arquivo database/database.sqlite é criado pelo "composer setup").
DB_CONNECTION=sqlite

# Para usar MySQL (ex.: docker compose -f database/docker-compose.yml up -d), comente a linha
# DB_CONNECTION=sqlite acima e descomente as linhas abaixo:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mysqlDB
# DB_USERNAME=root
# DB_PASSWORD=mysqlPW

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12
